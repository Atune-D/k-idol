.DS_Store

# Rojo build output (rojo build -o build/...)
build/
# Generated by `rojo sourcemap` for editor tooling
/sourcemap.json
# Place files built or saved at the project root, and Studio lock files
/*.rbxl
/*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Claude Code: temporary working copies made by subagents, and per-machine settings
.claude/worktrees/
.claude/settings.local.json

# Secrets and credentials must never be committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.ROBLOSECURITY
